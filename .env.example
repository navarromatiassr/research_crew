# Proveedor y modelo del LLM, formato "<proveedor>/<modelo>".
MODEL=anthropic/claude-opus-5
# MODEL_TEMPERATURE=0.2   # opcional; algunos modelos solo aceptan la default

# Clave del proveedor elegido (dejá solo la que uses).
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Servidor HTTP
HOST=0.0.0.0
PORT=8000
RELOAD=false

# Human in the loop: pausa tras el resumen para aprobación humana.
HUMAN_REVIEW=false

# Conversar con BigQuery (solo lectura). Credenciales: ADC o GOOGLE_APPLICATION_CREDENTIALS.
BQ_PROJECT=
BQ_DATASET=proyecto.dataset
BQ_MAX_BYTES=1073741824
BQ_MAX_ROWS=200
